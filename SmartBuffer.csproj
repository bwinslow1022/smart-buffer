<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmartBuffer</RootNamespace>
    <AssemblyName>SmartBuffer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.9.3</Version>
    <Product>SmartBuffer</Product>
    <Description>Sets up OBS as an always-on clip recorder</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Microsoft.VisualBasic" />
    <!-- WinRT media player for the clip preview; these ship with every Windows 10/11 install, nothing is copied -->
    <Reference Include="Windows.Foundation"><HintPath>$(SystemRoot)\System32\WinMetadata\Windows.Foundation.winmd</HintPath><Private>false</Private></Reference>
    <Reference Include="Windows.Media"><HintPath>$(SystemRoot)\System32\WinMetadata\Windows.Media.winmd</HintPath><Private>false</Private></Reference>
    <Reference Include="Windows.UI"><HintPath>$(SystemRoot)\System32\WinMetadata\Windows.UI.winmd</HintPath><Private>false</Private></Reference>
    <Reference Include="Windows.System"><HintPath>$(SystemRoot)\System32\WinMetadata\Windows.System.winmd</HintPath><Private>false</Private></Reference>
    <Reference Include="Windows.Graphics"><HintPath>$(SystemRoot)\System32\WinMetadata\Windows.Graphics.winmd</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Runtime.WindowsRuntime"><HintPath>$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.WindowsRuntime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Numerics.Vectors"><HintPath>$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\System.Numerics.Vectors.dll</HintPath><Private>false</Private></Reference>
    <EmbeddedResource Include="assets\smartbuffer.lua" LogicalName="smartbuffer.lua" />
    <EmbeddedResource Include="assets\saved.wav" LogicalName="saved.wav" />
  </ItemGroup>

</Project>
